# Clerk publishable key (public, safe for the browser). Never put CLERK_SECRET_KEY here.
VITE_CLERK_PUBLISHABLE_KEY=
# Backend API base URL, including any version prefix. The production build uses https://api.ez-ielts.nexisci.space
# (see .github/workflows/deploy-pages.yml). Leave empty locally to use the built-in mock data.
VITE_API_BASE_URL=
